# API 网关地址
API_GATEWAY=
# App 通道（ApplicationType 1,1）签名盐值（Android 平台）
SIGN_SALT=
# 小程序通道（ApplicationType 1,5）签名盐值，与 SIGN_SALT 不可互换（Android 平台）
MINI_SIGN_SALT=
# iOS 平台专属验签盐：服务端按 UA 平台选盐，iOS 客户端必须用这一套，
# 用 Android 盐在 iOS 上登录/签到会判「验签失败」（2026-11-06 实测）。
# 仅 iOS 构建读取；未配置时回退 SIGN_SALT/MINI_SIGN_SALT。
IOS_SIGN_SALT=
# 客户端标识
API_CID=

# 微信兜底 AppID（第三方凭据，勿提交）
WECHAT_FALLBACK_APP_ID=

# App 与小程序积分签名分别配置，禁止混用。
APP_SIGN_SALT=
MINI_SIGN_SALT=
