<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_device_background" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="我的设备 · 点击选择" android:textSize="11sp" android:textColor="@color/widget_foreground" />
        <ImageView android:id="@+id/widget_settings" android:layout_width="40dp" android:layout_height="match_parent"
            android:padding="2dp" android:src="@drawable/widget_more" android:contentDescription="@string/device_widget_settings" />
    </LinearLayout>
    <include layout="@layout/widget_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
